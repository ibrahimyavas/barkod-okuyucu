{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "barkod-okuyucu",
  "compatibility_date": "2026-08-18",
  // Pure static SPA build - no Worker script needed, Cloudflare serves
  // dist/ directly from the edge. "single-page-application" fallback means
  // unknown paths resolve to index.html instead of 404ing, since this is a
  // client-side-routed app.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
